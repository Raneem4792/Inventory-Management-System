@model TestWebApplication.Models.ViewModels.DashboardVM

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Dashboard</h2>
        <p class="text-muted mb-0">
            Overview of your inventory management system
        </p>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-3 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="stat-title">Total Categories</span>

                        <div class="stat-icon icon-blue">
                            <i class="bi bi-tags"></i>
                        </div>
                    </div>

                    <h2 class="stat-number">@Model.TotalCategories</h2>

                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="stat-title">Total Items</span>

                        <div class="stat-icon icon-green">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>

                    <h2 class="stat-number">@Model.TotalItems</h2>

                </div>
            </div>
        </div>


        @if (User.IsInRole("Admin"))
        {
            <div class="col-lg-3 col-md-6">
                <div class="card dashboard-card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="stat-title">Total Users</span>
                            <div class="stat-icon icon-orange">
                                <i class="bi bi-person-circle"></i>
                            </div>
                        </div>
                        <h2 class="stat-number">@Model.TotalEmployees</h2>
                    </div>
                </div>
            </div>
        }

        <div class="col-lg-3 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="stat-title">Low Stock Items</span>

                        <div class="stat-icon icon-red">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                    </div>

                    <h2 class="stat-number">@Model.LowStockItems</h2>

                </div>
            </div>
        </div>

    </div>

    <div class="card dashboard-table-card">

        <div class="card-header bg-white border-0 pt-4 px-4 pb-3">
            <h5 class="fw-bold mb-1">
                <i class="bi bi-clock-history me-2"></i>
                Recent Stock Transactions
            </h5>

            <p class="text-muted small mb-0">
                Latest inventory movements
            </p>
        </div>

        <div class="card-body pt-0 px-4 pb-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Item Name</th>
                            <th>Transaction Type</th>
                            <th>Quantity</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.LatestTransactions != null &&
                             Model.LatestTransactions.Any())
                        {
                            foreach (var transaction in Model.LatestTransactions)
                            {<tr>
                                    <td class="fw-medium">
                                        @transaction.Item?.Name
                                    </td>

                                    <td>
                                        @if (transaction.Type == "IN")
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="bi bi-arrow-down-circle me-1"></i>
                                                IN
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">
                                                <i class="bi bi-arrow-up-circle me-1"></i>
                                                OUT
                                            </span>
                                        }
                                    </td>

                                    <td>@transaction.Quantity</td>

                                    <td class="text-muted">
                                        @transaction.CreatedDate.ToString("yyyy-MM-dd")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    No recent transactions available.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>