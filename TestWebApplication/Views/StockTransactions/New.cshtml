@model TestWebApplication.Models.ViewModels.StockTransactionsVM

@{
    ViewData["Title"] = "New Stock Transaction";
}

<div class="form-page">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">New Stock Transaction</h2>
        <p class="text-muted mb-0">
            Record incoming or outgoing inventory stock
        </p>
    </div>

    <div class="card form-card">

        <div class="card-body p-4">

            <partial name="_Notifications" />

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="ItemId" class="form-label fw-medium">
                            Item
                        </label>

                        <select asp-for="ItemId"
                                asp-items="ViewBag.items"
                                class="form-select">

                            <option value="">Select Item</option>

                        </select>

                        <span asp-validation-for="ItemId"
                              class="text-danger small"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Quantity" class="form-label fw-medium">
                            Quantity
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Enter quantity" />

                        <span asp-validation-for="Quantity"
                              class="text-danger small"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Type" class="form-label fw-medium">
                            Transaction Type
                        </label>

                        <select asp-for="Type" class="form-select">
                            <option value="IN">IN - Add Stock</option>
                            <option value="OUT">OUT - Remove Stock</option>
                        </select>

                        <span asp-validation-for="Type"
                              class="text-danger small"></span>

                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="bi bi-check-lg me-1"></i>
                        Submit Transaction

                    </button>

                    <a asp-area=""
                       asp-controller="StockTransactions"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}