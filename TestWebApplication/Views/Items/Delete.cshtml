@model Item

@{
    ViewData["Title"] = "Delete Item";
}

<div class="form-page">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Delete Item</h2>
        <p class="text-muted mb-0">
            Review item details before deleting
        </p>
    </div>

    <div class="card form-card">

        <div class="card-body p-4">

            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Are you sure you want to delete this item?
                This action cannot be undone.
            </div>

            <form method="post"
                  asp-area=""
                  asp-controller="Items"
                  asp-action="DeleteItem">

                <input type="hidden" asp-for="Id" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-medium">
                            Item Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-medium">
                            Price
                        </label>

                        <input asp-for="Price"
                               class="form-control"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-medium">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="ViewBag.CategoryList"
                                class="form-select"
                                disabled>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Stock Quantity
                        </label>

                        <input value="@Model.Quantity"
                               class="form-control"
                               disabled />
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="bi bi-trash3 me-1"></i>
                        Delete Item
                    </button>

                    <a asp-area=""
                       asp-controller="Items"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">

                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>