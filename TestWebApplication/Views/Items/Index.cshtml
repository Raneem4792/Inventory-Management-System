@model IEnumerable<Item>

@{
    ViewData["Title"] = "Items";
}

<div class="items-page">

    <partial name="_Notifications" />

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Items</h2>
            <p class="text-muted mb-0">
                Manage and track your inventory items
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-area=""
               asp-controller="Items"
               asp-action="New"
               class="btn btn-primary">

                <i class="bi bi-plus-lg me-1"></i>
                Add New Item
            </a>
        }

    </div>

    <div class="card mb-4">

        <div class="card-body p-4">

            <form method="get" asp-action="Index">

                <div class="row g-3 align-items-end">

                    <div class="col-md-5">
                        <label class="form-label fw-medium">Search Items</label>

                        <input type="text"
                               name="search"
                               value="@Context.Request.Query["search"]"
                               placeholder="Search by item name..."
                               class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-medium">Category</label>

                        <select name="categoryId" class="form-select">

                            <option value="">All Categories</option>

                            @foreach (var category in ViewBag.categories)
                            {
                                if (Context.Request.Query["categoryId"].ToString() == category.Id.ToString())
                                {
                                    <option value="@category.Id" selected>
                                        @category.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-md-3">
                        <div class="d-flex gap-2">

                            <button type="submit" class="btn btn-primary flex-fill">
                                <i class="bi bi-search me-1"></i>
                                Search
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Reset
                            </a>

                        </div>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <div class="card items-table-card">

        <div class="card-header bg-white border-0 px-4 pt-4 pb-3">

            <h5 class="fw-bold mb-1">
                <i class="bi bi-box-seam me-2"></i>
                Inventory Items
            </h5>

            <p class="text-muted small mb-0">
                View item details and stock availability
            </p>

        </div>

        <div class="card-body px-4 pb-4 pt-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Item Name</th>
                            <th>Price</th>
                            <th>Category</th>
                            <th>Image</th>
                            <th>Stock Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @item.Name
                                    </td>

                                    <td>
                                        @item.Price.ToString("0.00")
                                    </td>

                                    <td>
                                        @item.Category?.Name
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.imagePath))
                                        {
                                            <img src="~/images/@item.imagePath"
                                                 class="item-image"
                                                 alt="@item.Name" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                No Image
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Quantity == 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">
                                                Out of Stock
                                            </span>
                                        }
                                        else if (item.Quantity <= 5)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis">
                                                Low Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                In Stock
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">

                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-area=""
                                                   asp-controller="Items"
                                                   asp-action="Edit"
                                                   asp-route-Id="@item.Id"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Edit Item">

                                                    <i class="bi bi-pencil-square"></i>
                                                </a>

                                                <a asp-area=""
                                                   asp-controller="Items"
                                                   asp-action="Delete"
                                                   asp-route-Id="@item.Id"
                                                   class="btn btn-sm btn-outline-danger"
                                                   title="Delete Item">

                                                    <i class="bi bi-trash3"></i>
                                                </a>
                                            }
                                            <a asp-area=""
                                               asp-controller="StockTransactions"
                                               asp-action="New"
                                               asp-route-itemId="@item.Id"
                                               class="btn btn-sm btn-success text-nowrap">

                                                <i class="bi bi-arrow-left-right me-1"></i>
                                                Manage Stock
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">

                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                                    No items found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>