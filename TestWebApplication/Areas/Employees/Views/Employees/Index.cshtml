@model IEnumerable<TestWebApplication.Models.Employees>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Employees";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="employees-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Employees</h2>
            <p class="text-muted mb-0">
                Manage employee information and records
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-area="Employees"
               asp-controller="Employees"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-lg me-1"></i>
                Add New Employee
            </a>
        }

    </div>

    <div class="card employees-table-card">

        <div class="card-header bg-white border-0 px-4 pt-4 pb-3">

            <h5 class="fw-bold mb-1">
                <i class="bi bi-people me-2"></i>
                Employee List
            </h5>

            <p class="text-muted small mb-0">
                View and manage employee details
            </p>

        </div>

        <div class="card-body px-4 pb-4 pt-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Employee Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Age</th>
                            <th>Salary</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var employee in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @employee.EmployeeName
                                    </td>

                                    <td>
                                        @employee.EmployeePhone
                                    </td>

                                    <td>
                                        @employee.EmployeeEmail
                                    </td>

                                    <td>
                                        @employee.EmployeeAge
                                    </td>

                                    <td>
                                        @employee.EmployeeSalary
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">

                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-area="Employees"
                                                   asp-controller="Employees"
                                                   asp-action="Edit"
                                                   asp-route-id="@employee.Id"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Edit Employee">

                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                            }

                                            <a asp-area="Employees"
                                               asp-controller="Employees"
                                               asp-action="Details"
                                               asp-route-id="@employee.Id"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Employee Details">

                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-area="Employees"
                                                   asp-controller="Employees"
                                                   asp-action="Delete"
                                                   asp-route-id="@employee.Id"
                                                   class="btn btn-sm btn-outline-danger"
                                                   title="Delete Employee">

                                                    <i class="bi bi-trash3"></i>
                                                </a>
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                                    No employees found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>