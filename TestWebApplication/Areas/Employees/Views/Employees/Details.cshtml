@model TestWebApplication.Models.Employees
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Employee Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-page">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Employee Details</h2>
        <p class="text-muted mb-0">
            View employee information
        </p>
    </div>

    <div class="card form-card">

        <div class="card-body p-4">

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label fw-medium">
                        Employee Name
                    </label>

                    <input value="@Model.EmployeeName"
                           class="form-control"
                           readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-medium">
                        Phone Number
                    </label>

                    <input value="@Model.EmployeePhone"
                           class="form-control"
                           readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-medium">
                        Email Address
                    </label>

                    <input value="@Model.EmployeeEmail"
                           class="form-control"
                           readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-medium">
                        Age
                    </label>

                    <input value="@Model.EmployeeAge"
                           class="form-control"
                           readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-medium">
                        Salary
                    </label>

                    <input value="@Model.EmployeeSalary"
                           class="form-control"
                           readonly />
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">

                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Employees"
                       asp-controller="Employees"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary px-4">

                        <i class="bi bi-pencil-square me-1"></i>
                        Edit Employee

                    </a>
                }

                <a asp-area="Employees"
                   asp-controller="Employees"
                   asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    Back to Employees

                </a>

            </div>

        </div>

    </div>

</div>