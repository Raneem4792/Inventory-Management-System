@model TestWebApplication.Models.Employees
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Edit Employee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-page">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Edit Employee</h2>
        <p class="text-muted mb-0">
            Update employee information
        </p>
    </div>

    <div class="card form-card">

        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="EmployeeName" class="form-label fw-medium">
                            Employee Name
                        </label>

                        <input asp-for="EmployeeName"
                               class="form-control"
                               placeholder="Enter employee name" />

                        <span asp-validation-for="EmployeeName"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmployeePhone" class="form-label fw-medium">
                            Phone Number
                        </label>

                        <input asp-for="EmployeePhone"
                               class="form-control"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="EmployeePhone"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmployeeEmail" class="form-label fw-medium">
                            Email Address
                        </label>

                        <input asp-for="EmployeeEmail"
                               class="form-control"
                               placeholder="Enter email address" />

                        <span asp-validation-for="EmployeeEmail"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmployeeAge" class="form-label fw-medium">
                            Age
                        </label>

                        <input asp-for="EmployeeAge"
                               class="form-control"
                               placeholder="Enter employee age" />

                        <span asp-validation-for="EmployeeAge"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmployeeSalary" class="form-label fw-medium">
                            Salary
                        </label>

                        <input asp-for="EmployeeSalary"
                               class="form-control"
                               placeholder="Enter employee salary" />

                        <span asp-validation-for="EmployeeSalary"
                              class="text-danger small"></span>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>
                        Save Changes
                    </button>

                    <a asp-area="Employees"
                       asp-controller="Employees"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}