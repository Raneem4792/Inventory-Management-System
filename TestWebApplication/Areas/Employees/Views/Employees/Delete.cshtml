@model TestWebApplication.Models.Employees
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Delete Employee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-page">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Delete Employee</h2>
        <p class="text-muted mb-0">
            Review employee information before deleting
        </p>
    </div>

    <div class="card form-card">

        <div class="card-body p-4">

            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Are you sure you want to delete this employee?
                This action cannot be undone.
            </div>

            <form asp-area="Employees"
                  asp-controller="Employees"
                  asp-action="Delete"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Employee Name
                        </label>

                        <input value="@Model.EmployeeName"
                               class="form-control"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Phone Number
                        </label>

                        <input value="@Model.EmployeePhone"
                               class="form-control"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Email Address
                        </label>

                        <input value="@Model.EmployeeEmail"
                               class="form-control"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Age
                        </label>

                        <input value="@Model.EmployeeAge"
                               class="form-control"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Salary
                        </label>

                        <input value="@Model.EmployeeSalary"
                               class="form-control"
                               disabled />
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="bi bi-trash3 me-1"></i>
                        Delete Employee
                    </button>

                    <a asp-area="Employees"
                       asp-controller="Employees"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">

                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>